<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Analysis Result"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />

        </LinearLayout>

        <!-- Result Icon -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_mint_card"
            android:gravity="center"
            android:text="🩺"
            android:textSize="38sp" />

        <!-- Main Result Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/severityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_warning_card"
                android:gravity="center"
                android:padding="18dp"
                android:text="⚠️ Severity Level\nMedium Risk\nBased on your symptom answers"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Possible Condition"
                android:textColor="@color/slate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conditionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Seasonal Influenza"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_confidence_badge"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="78% confidence"
                android:textColor="@color/green"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Advice Card -->
        <TextView
            android:id="@+id/adviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:text="💊 BASIC ADVICE\n\nRest, drink fluids, and monitor your symptoms. If symptoms get worse, contact a doctor."
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <!-- Doctor Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recommended Doctor"
                android:textColor="@color/slate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/doctorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Recommended specialty:\nGeneral Practitioner"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/viewDoctorBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_green"
                android:text="View Doctor Profile"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Confirm Visit Button -->
        <Button
            android:id="@+id/confirmVisitBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_green"
            android:text="Confirm Visit"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <!-- Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="This result is not a medical diagnosis. Please consult a healthcare professional for accurate medical advice."
            android:textColor="@color/slate"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>