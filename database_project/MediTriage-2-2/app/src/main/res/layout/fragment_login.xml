<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="28sp"
            android:textColor="@color/slate" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in with your email or phone number"
            android:textSize="12sp"
            android:textColor="@color/slate"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMAIL ADDRESS"
            android:textColor="@color/slate"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/loginEmailInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="ahmed@gmail.com"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/fog" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHONE NUMBER"
            android:textColor="@color/slate"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/loginPhoneInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="+20 100 000 0000"
            android:inputType="phone"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/fog" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your email, phone, or both to sign in."
            android:textColor="@color/slate"
            android:textSize="11sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <Button
        android:id="@+id/loginSubmitBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:text="Sign In →"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@drawable/bg_button_green" />

</LinearLayout>
