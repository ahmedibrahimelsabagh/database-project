<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stone"
    android:orientation="vertical">

    <!-- HERO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_green_gradient"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:gravity="center"
                android:text="🩺"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/doctorNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommended Doctor"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/doctorSpecialtyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Specialist"
                android:textColor="#DDFFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- STATS ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_card_white"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/doctorRatingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ —"
                        android:textColor="@color/ink"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rating"
                        android:textColor="@color/slate"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/doctorFeeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— EGP"
                        android:textColor="@color/ink"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Per Visit"
                        android:textColor="@color/slate"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- CLINIC INFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLINIC INFO"
                    android:textColor="@color/slate"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/doctorClinicText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Loading..."
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/doctorPhoneText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📞 Loading..."
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/doctorDaysText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅 Loading..."
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- BOOK BUTTON -->
            <Button
                android:id="@+id/bookAppointmentBtn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_green"
                android:text="📅 Book Appointment"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
