<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forest"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:background="@drawable/bg_mint_card"
        android:gravity="center"
        android:text="🤖"
        android:textSize="46sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="Analyzing your\nsymptoms"
        android:textColor="@color/white"
        android:textSize="26sp" />

    <TextView
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Gemini AI is carefully reviewing your answers to provide accurate triage guidance"
        android:textColor="#70FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="●  Collecting symptom data"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="●  Sending to Gemini API"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="●  Identifying conditions…"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="●  Finding specialist doctor"
            android:textColor="#40FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="●  Generating advice"
            android:textColor="#40FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>