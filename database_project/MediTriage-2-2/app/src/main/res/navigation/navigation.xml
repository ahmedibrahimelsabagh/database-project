<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.meditriage.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.meditriage.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.meditriage.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.meditriage.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_triage"
            app:destination="@id/triageFragment" />
        <action
            android:id="@+id/action_home_to_history"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/triageFragment"
        android:name="com.example.meditriage.TriageFragment"
        android:label="Triage">
        <action
            android:id="@+id/action_triage_to_analyzing"
            app:destination="@id/analyzingFragment" />
    </fragment>

    <fragment
        android:id="@+id/analyzingFragment"
        android:name="com.example.meditriage.AnalyzingFragment"
        android:label="Analyzing">
        <action
            android:id="@+id/action_analyzing_to_result"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.meditriage.ResultFragment"
        android:label="Result">
        <action
            android:id="@+id/action_result_to_doctor"
            app:destination="@id/doctorProfileFragment" />
        <action
            android:id="@+id/action_result_to_confirm"
            app:destination="@id/confirmVisitFragment" />
    </fragment>

    <fragment
        android:id="@+id/confirmVisitFragment"
        android:name="com.example.meditriage.ConfirmVisitFragment"
        android:label="Confirm Visit">
        <action
            android:id="@+id/action_confirm_to_history"
            app:destination="@id/historyFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.meditriage.HistoryFragment"
        android:label="History">
        <action
            android:id="@+id/action_history_to_home"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_history_to_profile"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/doctorProfileFragment"
        android:name="com.example.meditriage.DoctorProfileFragment"
        android:label="Doctor Profile" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.meditriage.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_splash"
            app:destination="@id/splashFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_profile_to_history"
            app:destination="@id/historyFragment" />
    </fragment>

</navigation>
